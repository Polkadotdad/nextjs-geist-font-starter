# Required for real videos. Leave both empty to run in MOCK mode (free placeholder videos for testing).
FAL_KEY=
ANTHROPIC_API_KEY=

# Public URL of this server (used to build video links), e.g. https://toonz-api.onrender.com
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080
DATA_DIR=./data

# Credits
FREE_CREDITS=1
# RevenueCat webhook "Authorization" header value (set the same in RevenueCat dashboard)
REVENUECAT_WEBHOOK_AUTH=
# product_id=credits pairs, comma separated
CREDIT_PRODUCTS=toonz_credits_5=5,toonz_credits_20=20

# Pipeline tuning
SCENE_COUNT=3
MAX_CONCURRENT_JOBS=2
FAL_IMAGE_MODEL=fal-ai/nano-banana-2
FAL_IMAGE_EDIT_MODEL=fal-ai/nano-banana-2/edit
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.5-turbo/standard/image-to-video
FAL_TTS_MODEL=fal-ai/elevenlabs/tts/eleven-v3
CLAUDE_MODEL=claude-opus-5-5
